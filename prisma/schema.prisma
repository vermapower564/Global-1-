generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model adcampaign {
  id             String   @id @default(cuid())
  name           String
  platform       String
  budget         Float
  adSpend        Float
  leadsGenerated Int
  cpl            Float
  roas           Float
  ctr            String
  impressions    String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
}

model attendance {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime  @default(now())
  checkInTime  DateTime
  checkOutTime DateTime?
  hoursWorked  Float     @default(0)
  status       String    @default("PRESENT")
  createdAt    DateTime  @default(now())
  user         user      @relation(fields: [userId], references: [id], onDelete: NoAction, map: "Attendance_userId_fkey")

  @@index([userId], map: "Attendance_userId_fkey")
}

model auditlog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_fkey")
}

model client {
  id            String    @id @default(cuid())
  companyName   String    @unique(map: "Client_companyName_key")
  contactPerson String
  email         String    @unique(map: "Client_email_key")
  phone         String
  industry      String
  totalBilled   Float     @default(0)
  createdAt     DateTime  @default(now())
  project       project[]
}

model completedprojecthistory {
  id                String   @id @default(cuid())
  projectId         String   @unique(map: "CompletedProjectHistory_projectId_key")
  completionDate    DateTime
  rating            Int      @default(5)
  lastContactedNote String?  @db.Text
  codeSnippet       String?  @db.Text
  createdAt         DateTime @default(now())
  project           project  @relation(fields: [projectId], references: [id], onDelete: NoAction, map: "CompletedProjectHistory_projectId_fkey")
}

model dailyworkupdate {
  id             String                   @id @default(cuid())
  userId         String
  date           DateTime                 @default(now())
  hoursWorked    Float
  description    String                   @db.Text
  achievements   String?                  @db.Text
  blockers       String?                  @db.Text
  tomorrowPlan   String?                  @db.Text
  status         dailyworkupdate_status   @default(PENDING)
  rating         Int?
  managerRemarks String?                  @db.Text
  clientName     String?
  driveLinks     String?                  @db.Text
  endTime        String?
  gitCommits     String?                  @db.Text
  priority       dailyworkupdate_priority @default(MEDIUM)
  projectName    String
  screenshots    String?                  @db.Text
  startTime      String?
  submittedAt    DateTime                 @default(now())
  projectId      String?
  evidenceUrl    String?                  @db.VarChar(500)
  evidenceName   String?                  @db.VarChar(255)
  evidenceType   String?                  @db.VarChar(100)
  evidenceSize   Int?
  project        project?                 @relation(fields: [projectId], references: [id], map: "DailyWorkUpdate_projectId_fkey")
  user           user                     @relation(fields: [userId], references: [id], onDelete: NoAction, map: "DailyWorkUpdate_userId_fkey")
  workEvidence   workevidence[]

  @@index([userId], map: "DailyWorkUpdate_userId_fkey")
  @@index([projectId], map: "DailyWorkUpdate_projectId_fkey")
}

model workevidence {
  id                String          @id @default(cuid())
  dailyWorkUpdateId String
  fileName          String
  fileType          String
  fileSize          Int
  fileUrl           String          @db.VarChar(500)
  uploadedByUserId  String
  uploadedAt        DateTime        @default(now())
  dailyWorkUpdate   dailyworkupdate @relation(fields: [dailyWorkUpdateId], references: [id], onDelete: Cascade, map: "WorkEvidence_dailyWorkUpdateId_fkey")

  @@index([dailyWorkUpdateId], map: "WorkEvidence_dailyWorkUpdateId_fkey")
  @@index([uploadedByUserId], map: "WorkEvidence_uploadedByUserId_fkey")
}

model department {
  id        String   @id @default(cuid())
  name      String   @unique(map: "Department_name_key")
  code      String   @unique(map: "Department_code_key")
  createdAt DateTime @default(now())
  budget    Float    @default(0)
  headName  String?
  user      user[]
}

model designasset {
  id           String   @id @default(cuid())
  assetTitle   String
  platform     String
  format       String
  designerName String
  status       String   @default("APPROVED")
  assetUrl     String
  createdAt    DateTime @default(now())
}

model devcommittracker {
  id            String   @id @default(cuid())
  userId        String
  commitHash    String   @unique(map: "DevCommitTracker_commitHash_key")
  repository    String
  branch        String   @default("main")
  linesAdded    Int
  linesDeleted  Int
  commitMessage String   @db.Text
  committedAt   DateTime @default(now())
  user          user     @relation(fields: [userId], references: [id], onDelete: NoAction, map: "DevCommitTracker_userId_fkey")

  @@index([userId], map: "DevCommitTracker_userId_fkey")
}

model employeeinvitation {
  id          String    @id @default(cuid())
  token       String    @unique(map: "EmployeeInvitation_token_key")
  email       String
  name        String
  employeeId  String
  department  String
  role        String
  phone       String?
  status      String    @default("INVITED")
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
}

model otptoken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email], map: "OtpToken_email_idx")
}

model financetransaction {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  description String   @db.Text
  referenceNo String   @unique(map: "FinanceTransaction_referenceNo_key")
  date        DateTime @default(now())
}

model internassignment {
  id              String        @id @default(cuid())
  internStudentId String
  taskTitle       String
  assignedDate    DateTime      @default(now())
  dueDate         DateTime
  githubRepo      String
  status          String        @default("In Review")
  grade           String?
  mentorFeedback  String?       @db.Text
  createdAt       DateTime      @default(now())
  internstudent   internstudent @relation(fields: [internStudentId], references: [id], onDelete: NoAction, map: "InternAssignment_internStudentId_fkey")

  @@index([internStudentId], map: "InternAssignment_internStudentId_fkey")
}

model internstudent {
  id                    String             @id @default(cuid())
  name                  String
  university            String
  degree                String
  department            String
  mentorName            String
  stipend               Float              @default(20000)
  startDate             DateTime
  endDate               DateTime
  daysCompleted         Int                @default(0)
  totalDays             Int                @default(90)
  performanceScore      Float              @default(5)
  completedTasks        Int                @default(0)
  totalTasks            Int                @default(12)
  status                String             @default("Active Intern")
  assignedProject       String
  githubRepo            String?
  offeredFullTimeSalary Float              @default(750000)
  createdAt             DateTime           @default(now())
  internassignment      internassignment[]
}

model itasset {
  id                String   @id @default(cuid())
  assetName         String
  category          String
  serialNumber      String   @unique(map: "ITAsset_serialNumber_key")
  allocatedToUserId String?
  status            String   @default("Assigned")
  createdAt         DateTime @default(now())
  user              user?    @relation(fields: [allocatedToUserId], references: [id], map: "ITAsset_allocatedToUserId_fkey")

  @@index([allocatedToUserId], map: "ITAsset_allocatedToUserId_fkey")
}

model leaverequest {
  id                String                 @id @default(cuid())
  userId            String
  leaveType         String
  startDate         DateTime
  endDate           DateTime
  totalDays         Int
  reason            String                 @db.Text
  status            String                 @default("PENDING")
  approvalStage     String                 @default("TEAM_LEADER")
  currentApproverId String?
  hrRemarks         String?                @db.Text
  appliedAt         DateTime               @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?
  attachmentUrl     String?                @db.VarChar(500)
  user              user                   @relation(fields: [userId], references: [id], onDelete: NoAction, map: "LeaveRequest_userId_fkey")
  approvalHistory   leaveapprovalhistory[]

  @@index([userId], map: "LeaveRequest_userId_fkey")
}

model leaveapprovalhistory {
  id             String       @id @default(cuid())
  leaveRequestId String
  actorId        String
  actorName      String
  actorRole      String
  action         String
  fromStage      String?
  toStage        String?
  comments       String?      @db.Text
  timestamp      DateTime     @default(now())
  leaveRequest   leaverequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade, map: "LeaveApprovalHistory_leaveRequestId_fkey")

  @@index([leaveRequestId], map: "LeaveApprovalHistory_leaveRequestId_fkey")
}

model payrollapproval {
  id           String         @id @default(cuid())
  userId       String
  employeeName String
  monthYear    String
  baseSalary   Float
  bonus        Float          @default(0)
  deductions   Float          @default(0)
  netPayable   Float
  status       payroll_status @default(APPROVED)
  bankRefNo    String?
  approvedAt   DateTime       @default(now())
  user         user           @relation(fields: [userId], references: [id], onDelete: NoAction, map: "PayrollApproval_userId_fkey")

  @@index([userId], map: "PayrollApproval_userId_fkey")
}

model salaryslip {
  id                   String    @id @default(cuid())
  userId               String
  employeeId           String
  employeeName         String
  salaryMonth          String
  monthKey             String
  basicSalary          Float     @default(0)
  hra                  Float     @default(0)
  allowances           Float     @default(0)
  bonus                Float     @default(0)
  overtime             Float     @default(0)
  grossSalary          Float     @default(0)
  pfDeduction          Float     @default(0)
  taxDeduction         Float     @default(0)
  otherDeductions      Float     @default(0)
  totalDeductions      Float     @default(0)
  netSalary            Float     @default(0)
  paymentDate          DateTime?
  paymentStatus        String    @default("PAID")
  paymentMethod        String    @default("Bank Transfer")
  transactionReference String?
  notes                String?   @db.Text
  generatedAt          DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  accountHolderName    String?
  accountNumberMasked  String?
  bankName             String?
  ifscCode             String?
  user                 user      @relation(fields: [userId], references: [id], onDelete: NoAction, map: "SalarySlip_userId_fkey")

  @@unique([userId, monthKey], map: "SalarySlip_userId_monthKey_key")
  @@index([userId], map: "SalarySlip_userId_fkey")
}

model pdfdocument {
  id           String   @id @default(cuid())
  documentType String
  title        String
  fileUrl      String   @db.Text
  relatedId    String?
  uploadedBy   String   @default("System Admin")
  fileSize     String   @default("1.2 MB")
  status       String   @default("VERIFIED")
  createdAt    DateTime @default(now())
  uploadedById String?
  user         user?    @relation(fields: [uploadedById], references: [id], map: "PdfDocument_uploadedById_fkey")

  @@index([uploadedById], map: "PdfDocument_uploadedById_fkey")
}

model project {
  id                      String                   @id @default(cuid())
  projectTitle            String
  clientCompany           String
  clientContactPerson     String
  clientEmail             String
  clientPhone             String
  startDate               DateTime
  endDate                 DateTime
  contractValue           Float
  status                  String                   @default("IN_PROGRESS")
  createdAt               DateTime                 @default(now())
  clientId                String?
  teamLeaderId            String?
  description             String?                  @db.Text
  projectCode             String?                  @db.VarChar(100)
  projectType             String?                  @default("WEB_APPLICATION") @db.VarChar(100)
  requiredSkills          String?                  @db.Text
  requiredRoles           String?                  @db.Text
  techStack               String?                  @db.Text
  expectedTeamSize        Int?                     @default(5)
  priority                String?                  @default("MEDIUM") @db.VarChar(50)
  projectManagerId        String?
  projectcomment          projectcomment[]
  projectreview           projectreview[]
  completedprojecthistory completedprojecthistory?
  dailyworkupdate         dailyworkupdate[]
  client                  client?                  @relation(fields: [clientId], references: [id], map: "Project_clientId_fkey")
  tasks                   task[]
  user                    user[]                   @relation("assignedstaffprojects")

  @@index([clientId], map: "Project_clientId_fkey")
}

model projectcomment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  comment   String   @db.Text
  createdAt DateTime @default(now())
  project   project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectComment_projectId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ProjectComment_userId_fkey")

  @@index([projectId], map: "ProjectComment_projectId_fkey")
  @@index([userId], map: "ProjectComment_userId_fkey")
}

model projectreview {
  id             String   @id @default(cuid())
  projectId      String
  reviewerUserId String
  reviewerRole   String
  overallStatus  String   @default("HEALTHY")
  progressNotes  String   @db.Text
  deliverables   String?  @db.Text
  blockers       String?  @db.Text
  rating         Int?     @default(5)
  createdAt      DateTime @default(now())
  project        project  @relation(fields: [projectId], references: [id], onDelete: Cascade, map: "ProjectReview_projectId_fkey")
  reviewer       user     @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade, map: "ProjectReview_reviewerUserId_fkey")

  @@index([projectId], map: "ProjectReview_projectId_fkey")
  @@index([reviewerUserId], map: "ProjectReview_reviewerUserId_fkey")
}

model promotionrecord {
  id               String    @id @default(cuid())
  employeeId       String
  userId           String
  employeeName     String
  previousRole     String
  newRole          String
  performanceScore Float
  reason           String    @db.Text
  promotedById     String
  promotedByName   String
  comments         String?   @db.Text
  createdAt        DateTime? @default(now()) @db.DateTime(0)

  @@index([employeeId], map: "employeeId")
  @@index([userId], map: "userId")
}

model resignation {
  id                      String             @id @default(cuid())
  resignationId           String             @unique(map: "Resignation_resignationId_key")
  userId                  String?
  employeeId              String
  employeeName            String
  email                   String
  department              String
  role                    String
  resignationDate         DateTime           @default(now())
  noticePeriodDays        Int                @default(15)
  lastWorkingDay          DateTime
  lastWorkingDayFormatted String?
  reason                  String             @db.Text
  status                  resignation_status @default(SUBMITTED)
  submittedAt             DateTime           @default(now())
  approvedAt              DateTime?
  approvedByUserId        String?
  approvedByName          String?
  approverRole            String?
  rejectedAt              DateTime?
  rejectedByUserId        String?
  rejectedByName          String?
  letterUrl               String?            @db.VarChar(500)
  createdAt               DateTime           @default(now())
  hrRemarks               String?            @db.Text
  managerRemarks          String?            @db.Text
  updatedAt               DateTime           @default(now()) @updatedAt
  user                    user?              @relation(fields: [userId], references: [id], map: "Resignation_userId_fkey")

  @@index([userId], map: "Resignation_userId_fkey")
}

model salesdeal {
  id            String   @id @default(cuid())
  dealTitle     String
  clientName    String
  dealValue     Float
  pipelineStage String   @default("PROSPECT")
  probability   Int      @default(50)
  closeDate     DateTime
  assignedExec  String
  createdAt     DateTime @default(now())
}

model seokeyword {
  id           String   @id @default(cuid())
  keyword      String   @unique(map: "SeoKeyword_keyword_key")
  searchVolume String
  currentRank  Int
  previousRank Int
  targetUrl    String
  status       String   @default("Improving")
  createdAt    DateTime @default(now())
}

model smtplog {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  emailType String
  status    String   @default("DISPATCHED")
  messageId String?
  createdAt DateTime @default(now())
}

model user {
  id                 String             @id @default(cuid())
  employeeId         String             @unique(map: "User_employeeId_key")
  name               String
  email              String             @unique(map: "User_email_key")
  password           String
  phone              String?
  role               String             @default("DEVELOPER") @db.VarChar(64)
  departmentId       String?
  managerId          String?
  joiningDate        DateTime           @default(now())
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  avatarUrl          String?
  documentsVerified  Boolean            @default(false)
  emergencyContact   String?
  isProfileCompleted Boolean            @default(false)
  salary             Float              @default(0)
  isResigned         Boolean            @default(false)
  lastLoginAt        DateTime?
  noticePeriodDays   Int                @default(15)
  paymentScheduleDay Int                @default(1)
  skills             String?            @db.Text
  experienceYears    Float?             @default(2)
  failedLoginAttempts Int               @default(0)
  lockoutUntil       DateTime?          @db.DateTime(3)
  attendance         attendance[]
  auditlog           auditlog[]
  bankDetail         bankdetail?
  dailyworkupdate    dailyworkupdate[]
  devcommittracker   devcommittracker[]
  itasset            itasset[]
  leaverequest       leaverequest[]
  notification       notification[]
  payrollapproval    payrollapproval[]
  pdfdocument        pdfdocument[]
  resignation        resignation[]
  salaryslips        salaryslip[]
  assignedTasks      task[]             @relation("AssignedTasks")
  createdTasks       task[]             @relation("CreatedTasks")
  taskcomment        taskcomment[]
  taskhistory        taskhistory[]
  projectcomment     projectcomment[]
  projectreview      projectreview[]
  department         department?        @relation(fields: [departmentId], references: [id], map: "User_departmentId_fkey")
  manager            user?              @relation("ManagerEmployees", fields: [managerId], references: [id], map: "User_managerId_fkey")
  employees          user[]             @relation("ManagerEmployees")
  project            project[]          @relation("assignedstaffprojects")

  @@index([departmentId], map: "User_departmentId_fkey")
  @@index([managerId], map: "User_managerId_fkey")
}

model bankdetail {
  id                String   @id @default(cuid())
  userId            String   @unique(map: "BankDetail_userId_key")
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  branchName        String?
  accountType       String   @default("Savings")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "BankDetail_userId_fkey")

  @@index([userId], map: "BankDetail_userId_fkey")
}

model task {
  id                String        @id @default(cuid())
  title             String
  description       String?       @db.Text
  projectId         String?
  assignedToUserId  String
  createdById       String?
  status            String        @default("ASSIGNED")
  priority          String        @default("MEDIUM")
  progress          Int           @default(0)
  startDate         DateTime      @default(now())
  dueDate           DateTime
  completedAt       DateTime?
  estimatedHours    Float         @default(8)
  actualHours       Float         @default(0)
  blockerReason     String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  section           String?
  reviewNotes       String?       @db.Text
  parentTaskId      String?
  isMainTask        Boolean       @default(false)
  manualProjectName String?
  assignedToUser    user          @relation("AssignedTasks", fields: [assignedToUserId], references: [id], onDelete: NoAction, map: "Task_assignedToUserId_fkey")
  createdBy         user?         @relation("CreatedTasks", fields: [createdById], references: [id], map: "Task_createdById_fkey")
  project           project?      @relation(fields: [projectId], references: [id], map: "Task_projectId_fkey")
  taskcomment       taskcomment[]
  taskhistory       taskhistory[]

  @@index([assignedToUserId], map: "Task_assignedToUserId_fkey")
  @@index([createdById], map: "Task_createdById_fkey")
  @@index([projectId], map: "Task_projectId_fkey")
}

model taskhistory {
  id          String   @id @default(cuid())
  taskId      String
  userId      String?
  action      String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now())
  task        task     @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "TaskHistory_taskId_fkey")
  user        user?    @relation(fields: [userId], references: [id], map: "TaskHistory_userId_fkey")

  @@index([taskId], map: "TaskHistory_taskId_fkey")
  @@index([userId], map: "TaskHistory_userId_fkey")
}

model taskcomment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  commentText String   @db.Text
  createdAt   DateTime @default(now())
  task        task     @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "TaskComment_taskId_fkey")
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TaskComment_userId_fkey")

  @@index([taskId], map: "TaskComment_taskId_fkey")
  @@index([userId], map: "TaskComment_userId_fkey")
}

model notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([userId], map: "Notification_userId_fkey")
}

model videoproductionitem {
  id            String   @id @default(cuid())
  projectTitle  String
  shootLocation String
  cameraLead    String
  editorName    String
  renderStage   String
  status        String   @default("FINAL_APPROVED")
  versionUrl    String
  createdAt     DateTime @default(now())
}

model customerreview {
  id                  String    @id @default(cuid())
  employeeId          String
  userId              String?
  employeeName        String
  projectId           String?
  projectName         String?
  customerName        String
  customerEmail       String
  customerCompany     String?
  customerRole        String?
  rating              Int       @default(5)
  communicationRating Int       @default(5)
  codeQualityRating   Int       @default(5)
  timelinessRating    Int       @default(5)
  reviewTitle         String    @db.VarChar(255)
  feedbackText        String    @db.Text
  highlights          String?   @db.VarChar(255)
  serviceCategory     String    @default("Engineering")
  status              String    @default("PUBLISHED") @db.VarChar(50)
  shareableToken      String?
  verifiedByClient    Boolean   @default(true)
  clientAvatar        String?   @db.VarChar(255)
  responseComment     String?   @db.Text
  respondedAt         DateTime? @db.DateTime(0)
  createdAt           DateTime  @default(now()) @db.DateTime(0)
  updatedAt           DateTime  @default(now()) @updatedAt @db.DateTime(0)

  @@index([employeeId], map: "idx_customerreview_employeeId")
  @@index([userId], map: "idx_customerreview_userId")
  @@index([rating], map: "idx_customerreview_rating")
  @@index([status], map: "idx_customerreview_status")
}

model featurerequest {
  id             String    @id @default(cuid())
  userId         String
  userName       String
  userEmail      String
  userRole       String
  title          String    @db.VarChar(255)
  description    String    @db.Text
  useCase        String    @db.Text
  priority       String    @default("MEDIUM") @db.VarChar(50)
  status         String    @default("SUBMITTED") @db.VarChar(50)
  adminRemarks   String?   @db.Text
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime? @db.DateTime(0)
  createdAt      DateTime? @default(now()) @db.DateTime(0)
  updatedAt      DateTime? @default(now()) @updatedAt @db.DateTime(0)
}

enum dailyworkupdate_status {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum dailyworkupdate_priority {
  HIGH
  MEDIUM
  LOW
}

enum resignation_status {
  SUBMITTED
  UNDER_REVIEW
  APPROVED

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model adcampaign {
  id             String   @id @default(cuid())
  name           String
  platform       String
  budget         Float
  adSpend        Float
  leadsGenerated Int
  cpl            Float
  roas           Float
  ctr            String
  impressions    String
  status         String   @default("Active")
  createdAt      DateTime @default(now())
}

model attendance {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime  @default(now())
  checkInTime  DateTime
  checkOutTime DateTime?
  hoursWorked  Float     @default(0)
  status       String    @default("PRESENT")
  createdAt    DateTime  @default(now())
  user         user      @relation(fields: [userId], references: [id], map: "Attendance_userId_fkey")

  @@index([userId], map: "Attendance_userId_fkey")
}

model auditlog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String   @db.Text
  ipAddress String?
  timestamp DateTime @default(now())
  user      user?    @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_fkey")
}

model client {
  id            String    @id @default(cuid())
  companyName   String    @unique(map: "Client_companyName_key")
  contactPerson String
  email         String    @unique(map: "Client_email_key")
  phone         String
  industry      String
  totalBilled   Float     @default(0)
  createdAt     DateTime  @default(now())
  project       project[]
}

model completedprojecthistory {
  id                String   @id @default(cuid())
  projectId         String   @unique(map: "CompletedProjectHistory_projectId_key")
  completionDate    DateTime
  rating            Int      @default(5)
  lastContactedNote String?  @db.Text
  codeSnippet       String?  @db.Text
  createdAt         DateTime @default(now())
  project           project  @relation(fields: [projectId], references: [id], map: "CompletedProjectHistory_projectId_fkey")
}

model dailyworkupdate {
  id             String                   @id @default(cuid())
  userId         String
  projectId      String?
  date           DateTime                 @default(now())
  hoursWorked    Float
  description    String                   @db.Text
  achievements   String?                  @db.Text
  blockers       String?                  @db.Text
  tomorrowPlan   String?                  @db.Text
  status         dailyworkupdate_status   @default(PENDING)
  rating         Int?
  managerRemarks String?                  @db.Text
  clientName     String?
  driveLinks     String?                  @db.Text
  endTime        String?
  gitCommits     String?                  @db.Text
  priority       dailyworkupdate_priority @default(MEDIUM)
  projectName    String
  screenshots    String?                  @db.Text
  startTime      String?
  submittedAt    DateTime                 @default(now())
  user           user                     @relation(fields: [userId], references: [id], map: "DailyWorkUpdate_userId_fkey")
  project        project?                 @relation(fields: [projectId], references: [id], map: "DailyWorkUpdate_projectId_fkey")

  @@index([userId], map: "DailyWorkUpdate_userId_fkey")
  @@index([projectId], map: "DailyWorkUpdate_projectId_fkey")
}

model department {
  id        String   @id @default(cuid())
  name      String   @unique(map: "Department_name_key")
  code      String   @unique(map: "Department_code_key")
  createdAt DateTime @default(now())
  budget    Float    @default(0)
  headName  String?
  user      user[]
}

model designasset {
  id           String   @id @default(cuid())
  assetTitle   String
  platform     String
  format       String
  designerName String
  status       String   @default("APPROVED")
  assetUrl     String
  createdAt    DateTime @default(now())
}

model devcommittracker {
  id            String   @id @default(cuid())
  userId        String
  commitHash    String   @unique(map: "DevCommitTracker_commitHash_key")
  repository    String
  branch        String   @default("main")
  linesAdded    Int
  linesDeleted  Int
  commitMessage String   @db.Text
  committedAt   DateTime @default(now())
  user          user     @relation(fields: [userId], references: [id], map: "DevCommitTracker_userId_fkey")

  @@index([userId], map: "DevCommitTracker_userId_fkey")
}

model employeeinvitation {
  id          String    @id @default(cuid())
  token       String    @unique(map: "EmployeeInvitation_token_key")
  email       String
  name        String
  employeeId  String
  department  String
  role        String
  phone       String?
  status      String    @default("INVITED")
  expiresAt   DateTime
  createdById String?
  createdAt   DateTime  @default(now())
  activatedAt DateTime?
}

model otptoken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email], map: "OtpToken_email_idx")
}

model financetransaction {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  description String   @db.Text
  referenceNo String   @unique(map: "FinanceTransaction_referenceNo_key")
  date        DateTime @default(now())
}

model internassignment {
  id              String        @id @default(cuid())
  internStudentId String
  taskTitle       String
  assignedDate    DateTime      @default(now())
  dueDate         DateTime
  githubRepo      String
  status          String        @default("In Review")
  grade           String?
  mentorFeedback  String?       @db.Text
  createdAt       DateTime      @default(now())
  internstudent   internstudent @relation(fields: [internStudentId], references: [id], map: "InternAssignment_internStudentId_fkey")

  @@index([internStudentId], map: "InternAssignment_internStudentId_fkey")
}

model internstudent {
  id                    String             @id @default(cuid())
  name                  String
  university            String
  degree                String
  department            String
  mentorName            String
  stipend               Float              @default(20000)
  startDate             DateTime
  endDate               DateTime
  daysCompleted         Int                @default(0)
  totalDays             Int                @default(90)
  performanceScore      Float              @default(5)
  completedTasks        Int                @default(0)
  totalTasks            Int                @default(12)
  status                String             @default("Active Intern")
  assignedProject       String
  githubRepo            String?
  offeredFullTimeSalary Float              @default(750000)
  createdAt             DateTime           @default(now())
  internassignment      internassignment[]
}

model itasset {
  id                String   @id @default(cuid())
  assetName         String
  category          String
  serialNumber      String   @unique(map: "ITAsset_serialNumber_key")
  allocatedToUserId String?
  status            String   @default("Assigned")
  createdAt         DateTime @default(now())
  user              user?    @relation(fields: [allocatedToUserId], references: [id], map: "ITAsset_allocatedToUserId_fkey")

  @@index([allocatedToUserId], map: "ITAsset_allocatedToUserId_fkey")
}

model leaverequest {
  id               String    @id @default(cuid())
  userId           String
  leaveType        String
  startDate        DateTime
  endDate          DateTime
  totalDays        Int
  reason           String    @db.Text
  status           String    @default("PENDING")
  hrRemarks        String?   @db.Text
  reviewedByUserId String?
  reviewedAt       DateTime?
  attachmentUrl    String?
  appliedAt        DateTime  @default(now())
  user             user      @relation(fields: [userId], references: [id], map: "LeaveRequest_userId_fkey")

  @@index([userId], map: "LeaveRequest_userId_fkey")
}

model payrollapproval {
  id           String         @id @default(cuid())
  userId       String
  employeeName String
  monthYear    String
  baseSalary   Float
  bonus        Float          @default(0)
  deductions   Float          @default(0)
  netPayable   Float
  status       payroll_status @default(APPROVED)
  bankRefNo    String?
  approvedAt   DateTime       @default(now())
  user         user           @relation(fields: [userId], references: [id], map: "PayrollApproval_userId_fkey")

  @@index([userId], map: "PayrollApproval_userId_fkey")
}

model salaryslip {
  id                   String    @id @default(cuid())
  userId               String
  employeeId           String
  employeeName         String
  salaryMonth          String
  monthKey             String
  basicSalary          Float     @default(0)
  hra                  Float     @default(0)
  allowances           Float     @default(0)
  bonus                Float     @default(0)
  overtime             Float     @default(0)
  grossSalary          Float     @default(0)
  pfDeduction          Float     @default(0)
  taxDeduction         Float     @default(0)
  otherDeductions      Float     @default(0)
  totalDeductions      Float     @default(0)
  netSalary            Float     @default(0)
  paymentDate          DateTime?
  paymentStatus        String    @default("PAID")
  paymentMethod        String    @default("Bank Transfer")
  transactionReference String?
  accountHolderName    String?
  bankName             String?
  accountNumberMasked  String?
  ifscCode             String?
  notes                String?   @db.Text
  generatedAt          DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  user                 user      @relation(fields: [userId], references: [id], map: "SalarySlip_userId_fkey")

  @@unique([userId, monthKey], map: "SalarySlip_userId_monthKey_key")
  @@index([userId], map: "SalarySlip_userId_fkey")
}

model pdfdocument {
  id           String   @id @default(cuid())
  documentType String
  title        String
  fileUrl      String   @db.Text
  relatedId    String?
  uploadedById String?
  uploadedBy   String   @default("System Admin")
  fileSize     String   @default("1.2 MB")
  status       String   @default("VERIFIED")
  createdAt    DateTime @default(now())
  user         user?    @relation(fields: [uploadedById], references: [id], map: "PdfDocument_uploadedById_fkey")

  @@index([uploadedById], map: "PdfDocument_uploadedById_fkey")
}

model project {
  id                      String                   @id @default(cuid())
  clientId                String?
  projectCode             String?
  projectTitle            String
  description             String?                  @db.Text
  clientCompany           String
  clientContactPerson     String
  clientEmail             String
  clientPhone             String
  startDate               DateTime
  endDate                 DateTime
  contractValue           Float                    @default(0)
  status                  String                   @default("ACTIVE")
  priority                String                   @default("MEDIUM")
  projectType             String?                  @default("WEB_APPLICATION")
  requiredSkills          String?                  @db.Text
  requiredRoles           String?                  @db.Text
  techStack               String?                  @db.Text
  expectedTeamSize        Int                      @default(5)
  projectManagerId        String?
  teamLeaderId            String?
  createdAt               DateTime                 @default(now())
  client                  client?                  @relation(fields: [clientId], references: [id], map: "Project_clientId_fkey")
  completedprojecthistory completedprojecthistory?
  dailyworkupdate         dailyworkupdate[]
  user                    user[]                   @relation("assignedstaffprojects")
  tasks                   task[]
  teamLeader              user?                    @relation("ProjectTeamLeader", fields: [teamLeaderId], references: [id], map: "Project_teamLeaderId_fkey")

  @@index([clientId], map: "Project_clientId_fkey")
  @@index([teamLeaderId], map: "Project_teamLeaderId_fkey")
}

model promotionrecord {
  id               String   @id @default(cuid())
  employeeId       String
  userId           String
  employeeName     String
  previousRole     String
  newRole          String
  performanceScore Float
  reason           String   @db.Text
  promotedById     String
  promotedByName   String
  comments         String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([employeeId])
}

model resignation {
  id                      String             @id @default(cuid())
  resignationId           String             @unique(map: "Resignation_resignationId_key")
  userId                  String?
  employeeId              String
  employeeName            String
  email                   String
  department              String
  role                    String
  resignationDate         DateTime           @default(now())
  noticePeriodDays        Int                @default(15)
  lastWorkingDay          DateTime
  lastWorkingDayFormatted String?
  reason                  String             @db.Text
  status                  resignation_status @default(SUBMITTED)
  managerRemarks          String?            @db.Text
  hrRemarks               String?            @db.Text
  approvedAt              DateTime?
  rejectedAt              DateTime?
  submittedAt             DateTime           @default(now())
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt
  user                    user?              @relation(fields: [userId], references: [id], map: "Resignation_userId_fkey")

  @@index([userId], map: "Resignation_userId_fkey")
}

model salesdeal {
  id            String   @id @default(cuid())
  dealTitle     String
  clientName    String
  dealValue     Float
  pipelineStage String   @default("PROSPECT")
  probability   Int      @default(50)
  closeDate     DateTime
  assignedExec  String
  createdAt     DateTime @default(now())
}

model seokeyword {
  id           String   @id @default(cuid())
  keyword      String   @unique(map: "SeoKeyword_keyword_key")
  searchVolume String
  currentRank  Int
  previousRank Int
  targetUrl    String
  status       String   @default("Improving")
  createdAt    DateTime @default(now())
}

model smtplog {
  id        String   @id @default(cuid())
  recipient String
  subject   String
  emailType String
  status    String   @default("DISPATCHED")
  messageId String?
  createdAt DateTime @default(now())
}

model user {
  id                 String             @id @default(cuid())
  employeeId         String             @unique(map: "User_employeeId_key")
  name               String
  email              String             @unique(map: "User_email_key")
  password           String
  phone              String?
  role               user_role          @default(DEVELOPER)
  departmentId       String?
  managerId          String?
  joiningDate        DateTime           @default(now())
  isActive           Boolean            @default(true)
  isResigned         Boolean            @default(false)
  noticePeriodDays   Int                @default(15)
  paymentScheduleDay Int                @default(1)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  avatarUrl          String?
  documentsVerified  Boolean            @default(false)
  emergencyContact   String?
  isProfileCompleted Boolean            @default(false)
  salary             Float              @default(0)
  skills             String?            @db.Text
  experienceYears    Float              @default(2.0)
  attendance         attendance[]
  auditlog           auditlog[]
  dailyworkupdate    dailyworkupdate[]
  devcommittracker   devcommittracker[]
  itasset            itasset[]
  leaverequest       leaverequest[]
  pdfdocument        pdfdocument[]
  payrollapproval    payrollapproval[]
  salaryslips        salaryslip[]
  bankDetail         bankdetail?
  resignation        resignation[]
  assignedTasks      task[]             @relation("AssignedTasks")
  createdTasks       task[]             @relation("CreatedTasks")
  taskhistory        taskhistory[]
  taskcomment        taskcomment[]
  notification       notification[]
  customerreviews    customerreview[]
  department         department?        @relation(fields: [departmentId], references: [id], map: "User_departmentId_fkey")
  manager            user?              @relation("ManagerEmployees", fields: [managerId], references: [id], map: "User_managerId_fkey")
  employees          user[]             @relation("ManagerEmployees")
  project            project[]          @relation("assignedstaffprojects")
  ledProjects        project[]          @relation("ProjectTeamLeader")

  @@index([departmentId], map: "User_departmentId_fkey")
  @@index([managerId], map: "User_managerId_fkey")
}

model bankdetail {
  id                String   @id @default(cuid())
  userId            String   @unique(map: "BankDetail_userId_key")
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  branchName        String?
  accountType       String   @default("Savings")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "BankDetail_userId_fkey")

  @@index([userId], map: "BankDetail_userId_fkey")
}

model task {
  id               String        @id @default(cuid())
  title            String
  description      String?       @db.Text
  projectId        String?
  manualProjectName String?
  section          String?
  reviewNotes      String?       @db.Text
  isMainTask       Boolean       @default(false)
  parentTaskId     String?
  assignedToUserId String
  createdById      String?
  status           String        @default("ASSIGNED")
  priority         String        @default("MEDIUM")
  progress         Int           @default(0)
  startDate        DateTime      @default(now())
  dueDate          DateTime
  completedAt      DateTime?
  estimatedHours   Float         @default(8.0)
  actualHours      Float         @default(0.0)
  blockerReason    String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  assignedToUser   user          @relation("AssignedTasks", fields: [assignedToUserId], references: [id], map: "Task_assignedToUserId_fkey")
  createdBy        user?         @relation("CreatedTasks", fields: [createdById], references: [id], map: "Task_createdById_fkey")
  project          project?      @relation(fields: [projectId], references: [id], map: "Task_projectId_fkey")
  parentTask       task?         @relation("MainTaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull, map: "Task_parentTaskId_fkey")
  subtasks         task[]        @relation("MainTaskSubtasks")
  taskhistory      taskhistory[]
  taskcomment      taskcomment[]

  @@index([assignedToUserId], map: "Task_assignedToUserId_fkey")
  @@index([createdById], map: "Task_createdById_fkey")
  @@index([projectId], map: "Task_projectId_fkey")
  @@index([parentTaskId], map: "Task_parentTaskId_fkey")
}

model taskhistory {
  id          String   @id @default(cuid())
  taskId      String
  userId      String?
  action      String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  description String   @db.Text
  createdAt   DateTime @default(now())
  task        task     @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "TaskHistory_taskId_fkey")
  user        user?    @relation(fields: [userId], references: [id], map: "TaskHistory_userId_fkey")

  @@index([taskId], map: "TaskHistory_taskId_fkey")
  @@index([userId], map: "TaskHistory_userId_fkey")
}

model taskcomment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  commentText String   @db.Text
  createdAt   DateTime @default(now())
  task        task     @relation(fields: [taskId], references: [id], onDelete: Cascade, map: "TaskComment_taskId_fkey")
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TaskComment_userId_fkey")

  @@index([taskId], map: "TaskComment_taskId_fkey")
  @@index([userId], map: "TaskComment_userId_fkey")
}

model notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([userId], map: "Notification_userId_fkey")
}

model videoproductionitem {
  id            String   @id @default(cuid())
  projectTitle  String
  shootLocation String
  cameraLead    String
  editorName    String
  renderStage   String
  status        String   @default("FINAL_APPROVED")
  versionUrl    String
  createdAt     DateTime @default(now())
}

model customerreview {
  id                  String   @id @default(cuid())
  employeeId          String
  userId              String?
  employeeName        String
  projectId           String?
  projectName         String?
  customerName        String
  customerEmail       String
  customerCompany     String?
  customerRole        String?
  rating              Int      @default(5)
  communicationRating Int      @default(5)
  codeQualityRating   Int      @default(5)
  timelinessRating    Int      @default(5)
  reviewTitle         String
  feedbackText        String   @db.Text
  highlights          String?
  serviceCategory     String   @default("Engineering")
  status              String   @default("PUBLISHED")
  shareableToken      String?
  verifiedByClient    Boolean  @default(true)
  clientAvatar        String?
  responseComment     String?  @db.Text
  respondedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  user                user?    @relation(fields: [userId], references: [id], map: "CustomerReview_userId_fkey")

  @@index([employeeId], map: "idx_customerreview_employeeId")
  @@index([userId], map: "idx_customerreview_userId")
  @@index([rating], map: "idx_customerreview_rating")
  @@index([status], map: "idx_customerreview_status")
}

enum user_role {
  SUPER_ADMIN
  ADMIN
  DIRECTOR
  HR
  ADMIN_HR
  FINANCE
  SALES_MANAGER
  SALES_EXECUTIVE
  DIGITAL_MARKETING_MANAGER
  SEO_EXECUTIVE
  CONTENT_WRITER
  GRAPHIC_DESIGNER
  VIDEO_EDITOR
  CAMERA_TEAM
  PROJECT_MANAGER
  TEAM_LEADER
  DEVELOPER
  UI_UX_DESIGNER
  INTERN
  CLIENT
}

enum dailyworkupdate_status {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum dailyworkupdate_priority {
  HIGH
  MEDIUM
  LOW
}

enum resignation_status {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum payroll_status {
  PENDING_APPROVAL
  APPROVED
  DISBURSED
  REJECTED
}
